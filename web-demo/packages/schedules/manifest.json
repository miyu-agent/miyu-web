{
  "id": "schedules",
  "version": "0.1.0",
  "name": {
    "zh": "定时任务",
    "en": "Scheduled tasks",
    "ja": "定期タスク"
  },
  "summary": {
    "zh": "在设置里看、建、停、删定时任务；右侧栏列这个会话上的",
    "en": "View, create, pause and delete scheduled tasks in Settings; the sidebar lists this session's",
    "ja": "設定で定期タスクを表示・作成・停止・削除。右サイドバーにこのセッションの分を表示"
  },
  "kind": "optional",
  "description": {
    "zh": "设置页多一页「定时任务」：一个任务一行（那句话、什么时候、在哪、下次），开关停续、删除；「新建」开一个浮窗：说什么、每天/每隔/一次/自定义、每次新开会话或跑在一个会话上。右侧栏多一张卡「定时任务」，列跑在这个会话上的（连 /loop）。旧核心没有定时任务的两处都不出。"
  },
  "inject": [
    "slots",
    "core",
    "chat~",
    "sessions",
    "settings~",
    "composer~"
  ],
  "styles": [
    "style.css"
  ],
