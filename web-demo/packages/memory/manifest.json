{
  "id": "memory",
  "version": "0.1.0",
  "name": {
    "zh": "记忆",
    "en": "Memory",
    "ja": "記憶"
  },
  "summary": {
    "zh": "在设置里查看、修改 AI 记住的事",
    "en": "View and edit what the AI remembers, in Settings",
    "ja": "AI が覚えていることを設定で確認・編集"
  },
  "kind": "optional",
  "description": {
    "zh": "设置页多一页「记忆」：一个人格一份（无人格也有一份），能搜、按类别筛、连作废的一起看；点开一条改内容和关键词、作废、找回；整理、清空这一份。/memory 直接打开。/dream 整理记忆，正文末尾看着它整理（日月轮转）。"
  },
  "provides": {
    "services": [
      "memory"
    ]
  },
  "inject": [
    "slots",
    "core",
    "commands",
    "chat",
    "settings~",
    "composer~",
    "mascot~"
  ],
  "styles": [
    "style.css"
  ],
