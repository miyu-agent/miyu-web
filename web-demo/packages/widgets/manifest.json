{
  "id": "widgets",
  "version": "0.1.0",
  "name": {
    "zh": "界面块",
    "en": "Widgets",
    "ja": "ウィジェット"
  },
  "summary": {
    "zh": "扩展包放在首页、面板、底栏、整页的内容",
    "en": "Content extensions put on the home page, panel, status bar and full pages",
    "ja": "拡張がホーム・パネル・ステータス・全画面に置く内容"
  },
  "kind": "optional",
  "description": {
    "zh": "扩展包声明的界面块（天气、构建状态这类），包只说放什么，网页自己画：新会话的首页、右边一栏的「面板」、输入框下面那一行的右边、软件的独立整页。只有字，不认 Markdown、HTML；能点的调它自己的方法、开它的整页、复制一段字。停用了就不画。"
  },
  "note": "核心 widgets.md（X-15）：subscribe {stream: widgets, session?, showing, page?}，推 widget.changed、resync；有人看核心才叫程序干活。",
  "inject": [
    "core",
    "host",
    "slots",
    "chat",
    "composer~",
    "backstage~",
    "icons?"
  ],
  "provides": {
    "services": [
      "widgets"
    ]
  },
  "settings": {},
  "styles": [
    "style.css"
  ],
