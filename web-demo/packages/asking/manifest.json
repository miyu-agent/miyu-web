{
  "id": "asking",
  "version": "0.1.0",
  "name": {
    "zh": "确认和提问",
    "en": "Confirmations and questions",
    "ja": "確認と質問"
  },
  "summary": {
    "zh": "在输入框中批准操作、回答提问",
    "en": "Approve actions and answer questions in the input box",
    "ja": "承認や質問への回答を入力欄で選べるようにする"
  },
  "kind": "optional",
  "description": {
    "zh": "她要你批准、要问你问题时，输入框变成一个抽屉让你选（照 TUI）；照会话的事件开，答了发 session.answer（核心 D-1、D-2）。"
  },
  "inject": [
    "slots",
    "chat",
    "composer",
    "core"
  ],
  "settings": {
    "max_vh": {
      "type": "number",
      "default": 60,
      "min": 20,
      "max": 90,
      "name": {
        "zh": "抽屉最高占窗口的百分之几"
      }
    },
    "preview_min_width": {
      "type": "number",
      "default": 560,
      "min": 0,
      "integer": true,
      "name": {
        "zh": "抽屉多宽时文字画放在选项右边（像素）"
      }
    },
    "esc_window_ms": {
      "type": "duration",
      "default": 1500,
      "name": {
        "zh": "两下 Esc 之间最多隔多久（和输入框的一样）"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
