{
  "id": "dashboard",
  "version": "0.1.0",
  "name": {
    "zh": "右侧边栏",
    "en": "Right sidebar",
    "ja": "右サイドバー"
  },
  "summary": {
    "zh": "右侧边栏：会话信息、待办、后台任务、文件修改、展示文件",
    "en": "Right sidebar: session info, to-dos, background tasks, file changes and shown files",
    "ja": "右サイドバー：セッション情報、ToDo、バックグラウンドタスク、ファイルの変更、表示したファイル"
  },
  "kind": "optional",
  "description": {
    "zh": "对话区右上角一个右栏开关（同左栏开关），点了开、收右侧边栏：四张卡，待办、后台任务（子代理再派的挂在下面）、文件修改、展示文件；点进去看后台命令的输出、文件的差异、展示的文件（预览工作区占过这一栏，左上角返回），子代理在主区打开。窗口够宽时做一栏，输入框那边的待办、后台任务不画；不够宽的盖在上面。停用了一切照旧，预览工作区照原来的样子。"
  },
  "inject": [
    "slots",
    "side",
    "sessions",
    "chat",
    "core",
    "composer",
    "storage",
    "packages"
  ],
  "settings": {
    "tick_ms": {
      "type": "duration",
      "default": 1000,
      "name": {
        "zh": "在跑的用时多久走一次"
      }
    },
    "cards": {
      "applies": "live",
      "type": "list",
      "of": "text",
      "default": ["todo", "tasks", "files", "shown"],
      "name": {
        "zh": "右栏卡片的先后（卡的编号；没写的照各自的先后接在后面）",
        "en": "Order of the sidebar cards (card ids; others follow in their own order)",
        "ja": "右サイドバーのカードの順（カードの ID。書いていないものは後ろに続く）"
      }
    },
    "cards_off": {
      "applies": "live",
      "type": "list",
      "of": "text",
      "default": [],
      "name": {
        "zh": "右栏不出的卡片（卡的编号）",
        "en": "Sidebar cards to hide (card ids)",
        "ja": "右サイドバーに出さないカード（カードの ID）"
      }
    },
    "card_rows": {
      "applies": "live",
      "type": "map",
      "of": "number",
      "min": 1,
      "max": 200,
      "integer": true,
      "default": {
        "todo": 6,
        "tasks": 10,
        "files": 10,
        "shown": 10
      },
      "name": {
        "zh": "右栏每张卡最多露几行（卡的编号 → 行数；多的在卡里滚）",
        "en": "Most rows each sidebar card shows (card id → rows; the rest scroll inside the card)",
        "ja": "右サイドバーの各カードに出す最大行数（カードの ID → 行数。あふれた分はカードの中でスクロール）"
      }
    },
    "card_rows_default": {
      "applies": "live",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 200,
      "integer": true,
      "name": {
        "zh": "右栏的卡没写行数时最多露几行",
        "en": "Most rows for a sidebar card not listed above",
        "ja": "上に書いていないカードの最大行数"
      }
    },
    "preview_lines": {
      "type": "number",
      "default": 400,
      "min": 1,
      "max": 5000,
      "integer": true,
      "name": {
        "zh": "后台命令的输出最多留几行"
      }
    }
  },
  "styles": [
    "style.css"
  ],
