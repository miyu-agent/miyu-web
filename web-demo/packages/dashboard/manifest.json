{
  "id": "dashboard",
  "version": "0.1.0",
  "name": {
    "zh": "仪表盘",
    "en": "Dashboard",
    "ja": "ダッシュボード"
  },
  "summary": {
    "zh": "右侧边栏：待办、后台任务、文件修改、展示文件",
    "en": "Right sidebar: to-dos, background tasks, file changes and shown files",
    "ja": "右サイドバー：ToDo、バックグラウンドタスク、ファイルの変更、表示したファイル"
  },
  "kind": "optional",
  "description": {
    "zh": "对话区右上角一个右栏开关（同左栏开关），点了开、收右侧边栏：四张卡，待办、后台任务（子代理再派的挂在下面）、文件修改、展示文件；点进去看后台命令的输出、文件的差异、展示的文件（预览工作区占过这一栏，左上角返回），子代理在主区打开。窗口够宽时做一栏，输入框那边的待办、后台任务不画；不够宽的盖在上面。停用了一切照旧，预览工作区照原来的样子。"
  },
  "inject": [
    "slots",
    "side",
    "sessions",
    "chat",
    "core",
    "composer",
    "storage"
  ],
  "settings": {
    "tick_ms": {
      "type": "duration",
      "default": 1000,
      "name": {
        "zh": "在跑的用时多久走一次"
      }
    },
    "todo_rows": {
      "type": "number",
      "default": 6,
      "min": 1,
      "max": 30,
      "integer": true,
      "name": {
        "zh": "待办最多露几项"
      }
    },
    "file_rows": {
      "type": "number",
      "default": 5,
      "min": 1,
      "max": 30,
      "integer": true,
      "name": {
        "zh": "文件修改最多露几个"
      }
    },
    "preview_lines": {
      "type": "number",
      "default": 400,
      "min": 1,
      "max": 5000,
      "integer": true,
      "name": {
        "zh": "后台命令的输出最多留几行"
      }
    }
  },
  "styles": [
    "style.css"
  ],
