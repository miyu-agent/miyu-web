{
  "id": "welcome",
  "version": "0.1.0",
  "name": {
    "zh": "第一次引导",
    "en": "First-run setup",
    "ja": "初回セットアップ"
  },
  "summary": {
    "zh": "第一次打开时配置语言、模型、人格和预设",
    "en": "Set up language, model, persona and preset on first launch",
    "ja": "初回起動時に言語・モデル・人格・プリセットを設定"
  },
  "kind": "optional",
  "description": {
    "zh": "核心的 ui.welcomed 是 false 时整页盖上引导：欢迎 → 界面语言 → 模型 → 人格 → 预设 → 完成，走完写 true（蓝图 web.md「第一次引导」）。排在对话页之前、别的服务都是用到时现找：没走过引导的这台设备一打开先盖一层底色，不露出空会话。供应商那一段、控件经 settings 包的服务 settings，人格、预设经 setup 包的服务 personas，吉祥物经 mascot 包的服务 mascot，站的那一段挂进它的挂载位 mascot.anchors。"
  },
  "inject": [
    "core",
    "host",
    "language",
    "storage",
    "slots",
    "chat~",
    "composer~",
    "settings~",
    "personas~",
    "mascot~",
    "theme~"
  ],
  "settings": {
    "stars": {
      "type": "number",
      "default": 16,
      "min": 0,
      "max": 60,
      "integer": true,
      "name": {
        "zh": "欢迎页的星点有几个"
      }
    },
    "mascot_scale": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 6,
      "integer": true,
      "name": {
        "zh": "欢迎页的吉祥物放大几倍"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh": {
      "steps": {
        "account": "账号",
        "language": "语言",
        "model": "模型",
        "persona": "人格",
        "theme": "外观",
        "profile": "关于你",
        "preset": "预设",
        "embed": "语义模型"
      },
      "hello": {
        "title": "Miyu",
        "start": "开始",
        "hint": "PRESS ENTER"
      },
      "language": {
        "title": "界面语言",
        "sub": "可在设置中修改",
        "system": "跟随系统"
      },
      "back": "上一步",
      "next": "下一步",
      "profile": {
        "title": "AI 怎么认识你",
        "sub": "可在设置中修改",
        "name": "AI 怎么称呼你",
        "name_hint": "名字或昵称",
        "about": "更多关于你的描述（可选）",
        "about_hint": "职业、兴趣、希望 AI 留意的事",
        "language": "{name}（可选）"
      },
      "done": {
        "title": "CLEAR!",
        "model": "模型 {name}",
        "persona": "人格 {name}",
        "preset": "预设 {name}",
        "start": "▶ 开始聊天",
        "got": "获得"
      },
      "failed": "保存失败：{reason}",
      "embed": {
        "title": "是否开启内置语义模型",
        "sub": "大幅提高记忆、知识库、表情包等内容的检索质量，但是会大幅提高内存占用，每次检索增加 CPU 开销",
        "local": "是（推荐）",
        "local_note": "",
        "off": "否",
        "off_note": "只用关键词检索",
        "local_note_download": "需下载 {size}",
        "downloading": "正在下载…",
        "progress": "正在下载 {done} / {total}",
        "failed": "下载失败：{why}\n可以以后在设置的软件包页里安装",
        "continue": "继续"
      },
      "skip": "跳过",
      "where": "STAGE {at}/{total}",
      "to_light": "切换到浅色",
      "to_dark": "切换到深色"
    },
