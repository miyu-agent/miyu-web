        "name": "AI 怎么称呼你",
        "name_hint": "名字或昵称",
        "about": "更多描述（可选）",
        "about_hint": "职业、兴趣、希望 AI 留意的事",
        "language": "{name}（可选）"
      },
      "sandbox": {
        "title": "沙盒",
        "sub": "新会话照它开局，可在设置中修改",
        "workspace": "开",
        "workspace_note": "工作区里读写，命令在沙盒里运行",
        "full": "关",
        "full_note": "完全放开，不再确认"
      },
      "done": {
        "title": "设置完成",
        "model": "模型 {name}",
        "persona": "人格 {name}",
        "preset": "预设 {name}",
        "start": "开始聊天"
      },
      "failed": "保存失败：{reason}",
      "embed": {
        "title": "是否开启内置语义模型",
        "sub": "大幅提高记忆、知识库、表情包等内容的检索质量，但是会提高大约 160 MB 内存占用（空闲 10 分钟后释放），每次检索增加约 10 毫秒 CPU 开销",
        "local": "是",
        "local_note": "推荐",
        "off": "否",
        "off_note": "只用关键词检索"
      }
    },
