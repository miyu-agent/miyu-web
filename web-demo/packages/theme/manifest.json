{
  "id": "theme",
  "version": "0.1.0",
  "name": {
    "zh": "配色方案",
    "en": "Color scheme",
    "ja": "配色"
  },
  "kind": "base",
  "description": {
    "zh": "照选中的配色方案和明暗把页面的颜色变量写上。配色方案由配色方案包挂进 theme.palettes，每个都是成对的一套（浅色、深色各一份）；明暗跟随系统、或定成浅色、深色。"
  },
  "inject": [
    "slots",
    "packages"
  ],
  "provides": {
    "services": [
      "theme"
    ]
  },
  "settings": {
    "palette": {
      "type": "text",
      "default": "",
      "name": {
        "zh": "用哪个配色方案（空着的照 default_palette）"
      },
      "applies": "live"
    },
    "default_palette": {
      "type": "text",
      "default": "persona",
      "name": {
        "zh": "没选配色方案时用哪个（编号；出厂跟随人格，没有这个配色方案的用第一个）"
      },
      "applies": "live",
      "advanced": true
    },
    "scheme": {
      "type": "choice",
      "choices": [
        "auto",
        "light",
        "dark"
      ],
      "default": "auto",
      "name": {
        "zh": "明暗（auto 跟随系统）"
      },
      "applies": "live"
    }
  },
  "styles": [
    "style.css"
  ]
}
