{
  "id": "theme",
  "version": "0.1.0",
  "name": {
    "zh": "主题",
    "en": "Theme",
    "ja": "テーマ"
  },
  "kind": "base",
  "description": {
    "zh": "照选中的主题和明暗把页面的颜色变量写上。主题由主题包挂进 theme.palettes，每个都是成对的一套（浅色、深色各一份）；明暗跟随系统、或定成浅色、深色。"
  },
  "inject": [
    "slots",
    "packages"
  ],
  "provides": {
    "services": [
      "theme"
    ]
  },
  "settings": {
    "palette": {
      "type": "text",
      "default": "",
      "name": {
        "zh": "用哪个主题（空着的是第一个）"
      },
      "applies": "live"
    },
    "scheme": {
      "type": "choice",
      "choices": [
        "auto",
        "light",
        "dark"
      ],
      "default": "auto",
      "name": {
        "zh": "明暗（auto 跟随系统）"
      },
      "applies": "live"
    }
  },
  "styles": [
    "style.css"
  ]
}
