{
  "id": "settings",
  "version": "0.1.0",
  "name": {
    "zh": "设置页",
    "en": "Settings",
    "ja": "設定"
  },
  "kind": "optional",
  "description": {
    "zh": "页面正中的弹窗：核心的配置和网页自己的设置都在这里改，改一项存一项（蓝图 web.md「设置页」）。"
  },
  "provides": {
    "services": [
      "settings"
    ]
  },
  "inject": [
    "slots",
    "icons",
    "core",
    "host",
    "packages",
    "commands",
    "theme~",
    "backstage~"
  ],
  "settings": {
    "width": {
      "type": "number",
      "default": 920,
      "min": 480,
      "integer": true,
      "name": {
        "zh": "框最宽多少（px）"
      }
    },
    "height": {
      "type": "number",
      "default": 680,
      "min": 360,
      "integer": true,
      "name": {
        "zh": "框最高多少（px）"
      }
    },
    "menu_search_after": {
      "type": "number",
      "default": 12,
      "min": 1,
      "integer": true,
      "name": {
        "zh": "下拉的选项多于这么多，顶上多一个搜索框"
      },
      "advanced": true
    },
    "narrow": {
      "type": "number",
      "default": 640,
      "min": 320,
      "integer": true,
      "name": {
        "zh": "框窄于这么宽（px）就占满整个窗口、分页点进去看"
      }
    },
    "pool_rows": {
      "type": "number",
      "default": 8,
      "min": 3,
      "integer": true,
      "name": {
        "zh": "模型池的成员最多露几行（多了在卡片里滚）"
      }
    },
    "order": {
      "type": "list",
      "of": "text",
      "default": [
        "general",
        "user",
        "models",
        "usage",
        "presets",
        "personas",
        "memory",
        "knowledge",
        "skills",
        "scripts",
        "mcp",
        "packages",
        "backstage",
        "advanced"
      ],
      "name": {
        "zh": "分页的先后（编号；核心多出来的页接在 advanced 前面）"
      },
      "advanced": true
    },
    "nav_groups": {
      "type": "list",
      "of": "text",
      "default": [
        "presets",
        "skills",
        "packages"
      ],
      "name": {
        "zh": "左栏分组：这几页是一组的开头，前面画一道线（编号）"
      },
      "advanced": true
    },
    "merge": {
      "type": "map",
      "of": "text",
      "default": {
        "interface": "general"
      },
      "name": {
        "zh": "项少的核心页并进哪一页（页 → 页）"
      },
      "advanced": true
    },
    "move_groups": {
      "type": "map",
      "of": "text",
      "default": {
        "catalog": "advanced",
        "cooldown": "advanced",
        "source": "advanced"
      },
      "name": {
        "zh": "挪到别的页的组（组 → 页）"
      },
      "advanced": true
    },
    "hide_prefixes": {
      "type": "list",
      "of": "text",
      "default": [
        "tui."
      ],
      "name": {
        "zh": "不列的别的头的项（键名的开头）"
      },
      "advanced": true
    },
    "icons": {
      "type": "map",
      "of": "text",
      "default": {
        "general": "sliders-horizontal",
        "user": "circle-user-round",
        "personas": "user-round",
        "memory": "brain",
        "usage": "gauge",
        "models": "cpu",
        "presets": "toggle-right",
        "advanced": "wrench",
        "packages": "package",
        "backstage": "gauge",
        "skills": "sparkles",
        "scripts": "square-terminal",
        "mcp": "plug"
      },
      "name": {
        "zh": "分页的图标（Lucide 的名字；没配的用 sliders-horizontal）"
      },
      "advanced": true
    }
  },
