{
  "id": "knowledge",
  "version": "0.1.0",
  "name": {
    "zh": "知识库",
    "en": "Knowledge",
    "ja": "ナレッジ"
  },
  "summary": {
    "zh": "在设置里管理知识库：搜、看原文、加文档、挂文件夹",
    "en": "Manage knowledge bases in Settings: search, read, add documents, mount folders",
    "ja": "設定でナレッジベースを管理：検索・原文表示・文書追加・フォルダのマウント"
  },
  "kind": "optional",
  "description": {
    "zh": "设置页多一页「知识库」：顶上搜索，空着时一个库一张卡片（自动想起的开关在卡片上）；点进去列文档、看原文，自己建的能加文档、删文档；挂的、随软件包来的只读。新建空库、挂一个现有文件夹；重建索引、删库。"
  },
  "inject": [
    "slots",
    "core",
    "host",
    "markdown~",
    "settings~"
  ],
  "styles": [
    "style.css"
  ],
