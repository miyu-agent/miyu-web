{
  "id": "usage",
  "version": "0.1.0",
  "name": {
    "zh": "用量",
    "en": "Usage",
    "ja": "使用量"
  },
  "summary": {
    "zh": "在设置里看用量和花费：按天、按模型、按会话、按用途",
    "en": "See usage and cost in Settings: by day, model, session and purpose",
    "ja": "設定で使用量と費用を確認：日別・モデル別・セッション別・用途別"
  },
  "kind": "optional",
  "description": {
    "zh": "设置页多一页「用量」：今天、7 天、30 天、全部、自定义，四格数（花费、请求、token、缓存命中），一张 token 柱子（一天的一小时一根），一张能切按模型、会话、用途、场所、每一列都能排、点一行浮出细则的表。数照核心的用量汇总，花费照币种各加各的。"
  },
  "inject": [
    "slots",
    "core",
    "chat~",
    "settings~"
  ],
  "styles": [
    "style.css"
  ],
